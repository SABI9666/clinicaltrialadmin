# ---------------------------------------------------------------------------
# Clinical Trial Access API — environment
# Copy to .env for local development. On Cloud Run these are set as env vars
# and secrets (see server/cloudbuild.yaml), never committed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# Sign admin sessions. Must be at least 32 characters in production.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h

# Comma-separated origins allowed to call the API (no trailing slash).
# Required in production — e.g. the Vercel frontend and admin URLs.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Persistence -----------------------------------------------------------
# false -> JSON file at DATA_FILE (local dev, no GCP credentials needed)
# true  -> Google Cloud Firestore (production)
USE_FIRESTORE=false
GCP_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
DATA_FILE=.data/store.json

# --- Image storage ---------------------------------------------------------
# false -> writes to LOCAL_UPLOAD_DIR and serves them from /uploads
# true  -> uploads to the Google Cloud Storage bucket below
USE_GCS=false
GCS_BUCKET=
GCS_PUBLIC_BASE_URL=
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608

# --- First-run bootstrap ---------------------------------------------------
# Creates this admin only when the user collection is empty.
# Change the password after the first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_ON_BOOT=true
