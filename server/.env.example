# ---------------------------------------------------------------------------
# Clinical Trial Access API — environment
# Copy to .env for local development. On Cloud Run these are set as env vars
# and secrets (see server/cloudbuild.yaml), never committed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# Sign admin sessions. Must be at least 32 characters in production.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h

# Comma-separated origins allowed to call the API (no trailing slash).
# Required in production — e.g. the Vercel frontend and admin URLs.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Persistence -----------------------------------------------------------
# Pick ONE backend. With neither set, the API uses a JSON file at DATA_FILE,
# which needs no database and is the easiest way to run locally.

# Postgres (Neon) — the production setup.
# Use Neon's POOLED connection string: the host contains "-pooler". Cloud Run
# scales to many instances and the direct endpoint runs out of connections.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
USE_POSTGRES=false
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Firestore — the alternative on GCP. Do not enable alongside USE_POSTGRES.
USE_FIRESTORE=false
FIRESTORE_DATABASE_ID=(default)

# Project id, also used by Cloud Storage below.
GCP_PROJECT_ID=

# Used only when neither backend above is enabled.
DATA_FILE=.data/store.json

# --- Image storage ---------------------------------------------------------
# false -> writes to LOCAL_UPLOAD_DIR and serves them from /uploads
# true  -> uploads to the Google Cloud Storage bucket below
USE_GCS=false
GCS_BUCKET=
GCS_PUBLIC_BASE_URL=
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608

# --- First-run bootstrap ---------------------------------------------------
# Creates this admin only when the user collection is empty.
# Change the password after the first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_ON_BOOT=true
