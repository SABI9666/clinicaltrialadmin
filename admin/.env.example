# The admin always calls /api on its own address. In production vercel.json
# forwards that to the Cloud Run API (set the URL there); locally the Vite dev
# server proxies it to VITE_DEV_API below. No API URL is needed here.

# Used only by `npm run dev` to proxy /api to a local backend.
VITE_DEV_API=http://localhost:8080
